# Application Environment
ENVIRONMENT=development
APP_NAME="Retail Transaction Analytics Platform"
DEBUG=True

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=retail_analytics_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Authentication & Security
# Generate a secure 32+ character secret key in production (e.g. using openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default Seed Administrator Credentials
ADMIN_EMAIL=admin@retail.com
ADMIN_DEFAULT_PASSWORD=Admin@123

# Data Pipeline Paths
DATASET_PATH=online_retail_II.xlsx
REPORTS_DIR=reports/generated

